# MongoDB Connection URI (e.g. MongoDB Atlas or local instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/blog_db?retryWrites=true&w=majority

# JWT Authentication Secret Key (minimum 32 characters recommended)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_32chars

# Optional App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
